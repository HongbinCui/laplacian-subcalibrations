(* ::Package:: *)
(* LSC-CLIFFORD-HESSIAN -- Clifford Hessian.
   Compatible with Mathematica 12. No external package or file dependencies.
   Get returns checks; only the central runner writes execution records.
   Supplemental algebraic derivation supporting the Clifford Hessian calculations; no current numbered statement is assigned.
   Exact verification in the formal four-dimensional algebra with basis Id,B,C,BC.
   All six Hessian contractions are derived from the Clifford relations and scalar contractions; this is not a finite-dimensional coordinate sample.
   The displayed six and five individual contributions are checked against the ancillary source note.
*)
(* Release: 20261011_memo_v7. Prepared: 2026-10-11.
   Current statement numbers and scope are recorded in CertificateIndex.md.
   Execute RunAll.wl to generate fresh results. *)

BeginPackage["LaplacianCertificates`CliffordHessian`"];
Begin["`Private`"];
ClearAll["LaplacianCertificates`CliffordHessian`Private`*"];

VerificationLog = {};
EvaluationMessages = {};
EvaluationOK = True;
VerificationVerbose = False;

(* Real powers occur only on the positive-base domains stated in the paper.
   In particular, the defining polynomial F is not assumed positive.
   Matrix equalities count as one assertion, with every entry tested. *)
AlgebraicResidual[expr_] := Module[{residual},
  residual = Factor[Together[PowerExpand[Expand[expr]]]];
  If[residual === 0, 0, Simplify[residual]]
];
CheckEqual[lhs_, rhs_, label_String] := Module[{residuals, passed},
  residuals = AlgebraicResidual /@ Flatten[{lhs - rhs}];
  passed = And @@ (TrueQ[# === 0] & /@ residuals);
  AppendTo[VerificationLog,
    {label, passed, If[passed, "0", ToString[residuals, InputForm]]}];
  If[passed,
    If[TrueQ[VerificationVerbose], Print["PASS: ", label]],
    Print["FAIL: ", label, "; residual = ", InputForm[residuals]]];
  passed
];
CheckTrue[condition_, label_String] := Module[{passed = TrueQ[condition]},
  AppendTo[VerificationLog,
    {label, passed, If[passed, "True", ToString[condition, InputForm]]}];
  If[passed,
    If[TrueQ[VerificationVerbose], Print["PASS: ", label]],
    Print["FAIL: ", label, "; condition = ", InputForm[condition]]];
  passed
];
RunVerificationGroup[label_String, fun_Symbol] := Module[{status, evaluationResult, messages},
  status = Block[{System`$MessageList = {}},
    evaluationResult = CheckAbort[Catch[fun[]; True, _, ($Failed &)], $Aborted];
    messages = ToString[#, InputForm] & /@ System`$MessageList;
    evaluationResult === True && Length[messages] == 0
  ];
  If[!TrueQ[status],
    EvaluationOK = False;
    AppendTo[EvaluationMessages, <|"Group" -> label, "Messages" -> messages,
      "Status" -> ToString[evaluationResult, InputForm]|>]];
  If[evaluationResult === $Aborted, Abort[]];
];


(* Supplemental Hessian derivation: exact contractions in the formal algebra generated by B=A_z
   and C=A_tau. This file is independent of LSC-CLIFFORD-CUBIC.
   jGradS denotes current J = Gamma(S,S), formerly K.
   The calculations below are self-contained supplemental identities.
   Coordinates in the basis {Id,B,C,BC} use B^2=v Id, C^2=t Id,
   BC+CB=2 f Id.  The scalar functional is y^T(.)y, with values
   {u,f,t,u f}.  These are the manuscript's Clifford identities.
   The computations check their consequences, not the existence/classification
   of a Clifford system. *)
CheckCliffordHessianAppendix[] := Module[
 {u,v,t,f,one,b,c,bc,table,multiply,transpose,evaluate,pair,
  a,d,x,yy,zz,uy,zy,uu,uz,zzp,zradU,zradZ,zUU,zUZ,zZZ,
  hFUU,hFUZ,hFZZ,hSUU,hSUZ,hSZZ,sixUZ,fiveZZ,sixUU,jGradS,m,
  eq,truth,allPassed=True},
 eq[lhs_,rhs_,label_] := If[!TrueQ[CheckEqual[lhs,rhs,label]],allPassed=False];
 truth[cond_,label_] := If[!TrueQ[CheckTrue[cond,label]],allPassed=False];
 one={1,0,0,0}; b={0,1,0,0}; c={0,0,1,0}; bc={0,0,0,1};
 table={{one,b,c,bc},{b,v one,bc,v c},
   {c,2 f one-bc,t one,2 f c-t b},
   {bc,2 f b-v c,t b,2 f bc-v t one}};
 multiply[a_,d_] := Total[Flatten[
   Table[a[[i]] d[[j]] table[[i,j]],{i,4},{j,4}],1]];
 transpose[a_] := a[[1]] one+a[[2]] b+a[[3]] c+a[[4]] (2 f one-bc);
 evaluate[a_] := Expand[a.{u,f,t,u f}];
 pair[a_,d_] := evaluate[multiply[transpose[a],d]];
 eq[multiply[b,b],v one,"E: B squared"];
 eq[multiply[c,c],t one,"E: C squared"];
 eq[multiply[b,c]+multiply[c,b],2 f one,"E: Clifford anticommutator"];
 eq[multiply[multiply[b,c],b],2 f b-v c,"E: B C B reduction"];
 d=2 v one+c;
 eq[evaluate[multiply[multiply[d,b],d]],f (4 v^2+4 u v+t),
   "E: y transpose D B D y"];
 eq[evaluate[multiply[b,d]],f (u+2 v),"E: y transpose B D y"];
 uy=2 b; zy=4 d;
 eq[pair[zy,zy],64 u v^2+64 v t+16 u t,"E: norm of Z_y"];
 eq[pair[zy,multiply[c,zy]],64 v^2 t+64 u v t+16 t^2,
   "E: C quadratic form on Z_y"];
 eq[evaluate[uy],2 f,"E: radial contraction with U_y"];
 eq[evaluate[zy],8 u v+4 t,"E: radial contraction with Z_y"];
 jGradS=16 (4 u v (u+v)+(u+4 v)t);
 m=4 u^2+12 u v+4 v^2+t;
 hFUU=2 pair[uy,multiply[b,uy]]+4 pair[c,uy];
 hFUZ=2 pair[uy,multiply[b,zy]]+2 pair[c,zy]+2 pair[8 u b,uy];
 hFZZ=2 pair[zy,multiply[b,zy]]+4 pair[8 u b,zy];
 eq[hFUU,8 (u+v)f,"E: Hess F(U,U), eq:HFUU"];
 eq[hFUZ,jGradS/2,"E: Hess F(U,Z), eq:HFUZ"];
 eq[hFZZ,32 f m,"E: Hess F(Z,Z), eq:HFZZ"];
 (* Scalar products of p_i(U)=2u z_i and p_i(Z)=4(u+2v) tau_i. *)
 uu=4 u^2 v; uz=8 u (u+2 v)f; zzp=16 (u+2 v)^2 t;
 zradU=f; zradZ=8 u v;
 zUU=t; zUZ=8 u f; zZZ=64 u^2 v;
 sixUU={8 v pair[uy,uy],8 uu,4 pair[uy,multiply[c,uy]],
  16 evaluate[uy]zradU,16 evaluate[uy]zradU,8 u zUU};
 sixUZ={8 v pair[uy,zy],8 uz,4 pair[uy,multiply[c,zy]],
  16 evaluate[uy]zradZ,16 evaluate[zy]zradU,8 u zUZ};
 fiveZZ={8 v pair[zy,zy],8 zzp,4 pair[zy,multiply[c,zy]],
  32 evaluate[zy]zradZ,8 u zZZ};
 eq[sixUZ,{64 u v f+128 v^2 f,64 u^2 f+128 u v f,
   64 u v f+32 t f,256 u v f,128 u v f+64 t f,64 u^2 f},
   "E: all six displayed contributions to Hess S(U,Z)"];
 eq[fiveZZ,{512 u v^3+512 v^2 t+128 u v t,
   128 u^2 t+512 u v t+512 v^2 t,
   256 v^2 t+256 u v t+64 t^2,
   2048 u^2 v^2+1024 u v t,512 u^3 v},
   "E: all five displayed contributions to Hess S(Z,Z)"];
 eq[Total[sixUU],32 u v^2+32 u^2 v+8 u t-16 v t+96 f^2,
   "E: Hess S(U,U), eq:HSUU"];
 eq[Total[sixUZ],f(128 u^2+640 u v+128 v^2+96 t),
   "E: Hess S(U,Z), eq:HSUZ"];
 eq[Total[fiveZZ],512 u v^3+2048 u^2 v^2+512 u^3 v+
   1280 v^2 t+1920 u v t+128 u^2 t+64 t^2,
   "E: Hess S(Z,Z), eq:HSZZ"];
 allPassed
];



Block[{$IterationLimit = Infinity, $Assumptions = True},
  RunVerificationGroup["CheckCliffordHessianAppendix", CheckCliffordHessianAppendix];
];

CertificateResult = <|"CertificateID" -> "LSC-CLIFFORD-HESSIAN",
  "ExpectedChecks" -> 18,
  "Checks" -> (<|"Name" -> #[[1]], "Passed" -> TrueQ[#[[2]]],
      "Detail" -> If[StringQ[#[[3]]], #[[3]], ToString[#[[3]], InputForm]]|> &) /@ VerificationLog,
  "EvaluationOK" -> TrueQ[EvaluationOK],
  "EvaluationMessages" -> EvaluationMessages|>;
End[];
EndPackage[];
LaplacianCertificates`CliffordHessian`Private`CertificateResult
